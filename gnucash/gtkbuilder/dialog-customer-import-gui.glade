<?xml version="1.0" encoding="utf-8"?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkDialog" id="customer_import_dialog">
    <property name="width-request">500</property>
    <property name="height-request">500</property>
    <property name="title" translatable="1" comments="Title of dialog">Import customers or vendors from text file</property>
<signal name="destroy" handler="gnc_customer_import_gui_destroy_cb" swapped="no" />
    <child internal-child="content_area">
      <object class="GtkBox" id="dialog-vbox1">
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <child>
          <object class="GtkFrame" id="frame1">
<property name="child">
              <object class="GtkCenterBox" id="hbox1">
<property name="start-widget">
                  <object class="GtkBox">
                    <child>
                      <object class="GtkEntry" id="entryFilename">
                        <property name="hexpand">1</property>
                        <property name="focusable">1</property>
                        <signal name="changed" handler="gnc_customer_import_gui_filenameChanged_cb" swapped="no" />
                      </object>
                    </child>
                  </object>
                </property>
                <property name="end-widget">
                  <object class="GtkBox">
                    <child>
                      <object class="GtkButton" id="buttonOpen">
                        <property name="halign">center</property>
                        <property name="label" translatable="1">_Open</property>
                        <property name="focusable">1</property>
                        <property name="use-underline">1</property>
                        <signal name="clicked" handler="gnc_customer_import_gui_buttonOpen_cb" swapped="no" />
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
            <child type="label">
              <object class="GtkLabel" id="label1">
                <property name="label" translatable="1">1. Choose the file to import</property>
                <style>
                  <class name="gnc-class-strong" />
                </style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkFrame" id="frame2">
<property name="child">
              <object class="GtkBox" id="box1">
                <property name="halign">start</property>
<child>
                  <object class="GtkCheckButton" id="radiobutton_customer">
                    <property name="label" translatable="1">Customer</property>
                    <property name="focusable">1</property>
                    <property name="tooltip-text" translatable="1">For importing customer lists.</property>
                    <property name="halign">start</property>
                    <signal name="toggled" handler="gnc_customer_import_gui_type_cb" swapped="no" />
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="radiobutton_vendor">
                    <property name="label" translatable="1">Vendor</property>
                    <property name="focusable">1</property>
                    <property name="tooltip-text" translatable="1">For importing vendor lists.</property>
                    <property name="halign">start</property>
                    <property name="group">radiobutton_customer</property>
                    <signal name="toggled" handler="gnc_customer_import_gui_type_cb" swapped="no" />
                  </object>
                </child>
              </object>
            </property>
            <child type="label">
              <object class="GtkLabel" id="label4">
                <property name="label" translatable="1">2. Select Import Type</property>
                <style>
                  <class name="gnc-class-strong" />
                </style>
                <property name="use-markup">1</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkFrame" id="frame3">
<property name="child">
              <object class="GtkBox" id="vbox1">
<property name="orientation">vertical</property>
                <child>
                  <object class="GtkCheckButton" id="radiobutton1">
                    <property name="valign">center</property>
                    <property name="label" translatable="1">Semicolon separated</property>
                    <property name="focusable">1</property>
                    <property name="halign">start</property>
                    <property name="use-underline">1</property>
                    <signal name="toggled" handler="gnc_customer_import_gui_option1_cb" swapped="no" />
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="radiobutton2">
                    <property name="valign">center</property>
                    <property name="label" translatable="1">Comma separated</property>
                    <property name="focusable">1</property>
                    <property name="halign">start</property>
                    <property name="use-underline">1</property>
                    <property name="group">radiobutton1</property>
                    <signal name="toggled" handler="gnc_customer_import_gui_option2_cb" swapped="no" />
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="radiobutton3">
                    <property name="valign">center</property>
                    <property name="label" translatable="1">Semicolon separated with quotes</property>
                    <property name="focusable">1</property>
                    <property name="halign">start</property>
                    <property name="use-underline">1</property>
                    <property name="group">radiobutton1</property>
                    <signal name="toggled" handler="gnc_customer_import_gui_option3_cb" swapped="no" />
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="radiobutton4">
                    <property name="valign">center</property>
                    <property name="label" translatable="1">Comma separated with quotes</property>
                    <property name="focusable">1</property>
                    <property name="halign">start</property>
                    <property name="use-underline">1</property>
                    <property name="group">radiobutton1</property>
                    <signal name="toggled" handler="gnc_customer_import_gui_option4_cb" swapped="no" />
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="radiobutton5">
                    <property name="valign">center</property>
                    <property name="label" translatable="1">Custom regular expression</property>
                    <property name="focusable">1</property>
                    <property name="halign">start</property>
                    <property name="use-underline">1</property>
                    <property name="group">radiobutton1</property>
                    <signal name="toggled" handler="gnc_customer_import_gui_option5_cb" swapped="no" />
                  </object>
                </child>
              </object>
            </property>
            <child type="label">
              <object class="GtkLabel" id="label2">
                <property name="label" translatable="1">3. Select import options</property>
                <style>
                  <class name="gnc-class-strong" />
                </style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkFrame" id="frame4">
<property name="child">
              <object class="GtkScrolledWindow" id="scrolledwindow2">
                <property name="focusable">1</property>
                <property name="hexpand">1</property>
                <property name="vexpand">1</property>
                <property name="child">
                  <object class="GtkBox" id="preview_placeholder">
                    <property name="height-request">120</property>
                    <property name="focusable">1</property>
                  </object>
                </property>
              </object>
            </property>
            <child type="label">
              <object class="GtkLabel" id="label3">
                <property name="label" translatable="1">4. Preview</property>
                <style>
                  <class name="gnc-class-strong" />
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <action-widgets>
      <action-widget response="-11">helpbutton</action-widget>
      <action-widget response="-6">cancelbutton</action-widget>
      <action-widget response="-5">okbutton</action-widget>
    </action-widgets>
    <child internal-child="action_area">
      <object class="GtkBox" id="dialog-action_area1">
        <property name="visible">True</property>
        <child>
          <object class="GtkButton" id="helpbutton">
            <property name="visible">0</property>
            <property name="label" translatable="1">_Help</property>
            <property name="focusable">1</property>
<property name="use-underline">1</property>
<signal name="clicked" handler="gnc_customer_import_gui_help_cb" swapped="no" />
          </object>

        </child>
        <child>
          <object class="GtkButton" id="cancelbutton">
            <property name="label" translatable="1">_Cancel</property>
            <property name="focusable">1</property>
<property name="use-underline">1</property>
            <signal name="clicked" handler="gnc_customer_import_gui_cancel_cb" swapped="no" />
          </object>

        </child>
        <child>
          <object class="GtkButton" id="okbutton">
            <property name="label" translatable="1">_OK</property>
            <property name="focusable">1</property>
            <property name="use-underline">1</property>
            <signal name="clicked" handler="gnc_customer_import_gui_ok_cb" swapped="no" />
          </object>

        </child>
      </object>
    </child>
  </object>
</interface>
