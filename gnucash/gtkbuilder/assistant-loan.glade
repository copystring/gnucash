<?xml version="1.0" encoding="utf-8"?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkListStore" id="len_liststore">
    <columns>
      <column type="gchararray" />
    </columns>
    <data>
      <row>
        <col id="0" translatable="yes">Months</col>
      </row>
      <row>
        <col id="0" translatable="yes">Years</col>
      </row>
    </data>
  </object>
  <object class="GtkListStore" id="range_liststore">
    <columns>
      <column type="gchararray" />
    </columns>
    <data>
      <row>
        <col id="0" translatable="yes">Current Year</col>
      </row>
      <row>
        <col id="0" translatable="yes">Now + 1 Year</col>
      </row>
      <row>
        <col id="0" translatable="yes">Whole Loan</col>
      </row>
      <row>
        <col id="0" translatable="yes">Custom</col>
      </row>
    </data>
  </object>
  <object class="GtkListStore" id="rate_liststore">
    <columns>
      <column type="gchararray" />
    </columns>
    <data>
      <row>
        <col id="0" translatable="yes">Interest Rate</col>
      </row>
      <row>
        <col id="0" translatable="yes">APR (Compounded Daily)</col>
      </row>
      <row>
        <col id="0" translatable="yes">APR (Compounded Weekly)</col>
      </row>
      <row>
        <col id="0" translatable="yes">APR (Compounded Monthly)</col>
      </row>
      <row>
        <col id="0" translatable="yes">APR (Compounded Quarterly)</col>
      </row>
      <row>
        <col id="0" translatable="yes">APR (Compounded Semi-annually)</col>
      </row>
      <row>
        <col id="0" translatable="yes">APR (Compounded Annually)</col>
      </row>
    </data>
  </object>
  <object class="GtkListStore" id="type_liststore">
    <columns>
      <column type="gchararray" />
    </columns>
    <data>
      <row>
        <col id="0" translatable="yes">Fixed Rate</col>
      </row>
      <row>
        <col id="0" translatable="yes">3/1 Year ARM</col>
      </row>
      <row>
        <col id="0" translatable="yes">5/1 Year ARM</col>
      </row>
      <row>
        <col id="0" translatable="yes">7/1 Year ARM</col>
      </row>
      <row>
        <col id="0" translatable="yes">10/1 Year ARM</col>
      </row>
    </data>
  </object>
  <object class="GtkAssistant" id="loan_mortgage_assistant">
<property name="default-width">400</property>
    <property name="default-height">400</property>
    <signal name="apply" handler="loan_assistant_finish" swapped="no" />
    <signal name="cancel" handler="loan_assistant_cancel" swapped="no" />
    <signal name="close" handler="loan_assistant_close" swapped="no" />
    <signal name="prepare" handler="loan_assistant_prepare" swapped="no" />
    <child>
      <object class="GtkAssistantPage">
        <property name="page-type">intro</property>
        <property name="title" translatable="1">Loan / Mortgage Repayment Setup</property>
        <property name="complete">True</property>
<property name="child">
          <object class="GtkLabel" id="loan_intro_page">
            <property name="valign">start</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="label" translatable="1">This is a step-by-step method for creating a loan repayment within GnuCash. In this assistant, you can input the details of your loan and its repayment along with the details of its payback. Using that information, the appropriate Scheduled Transactions will be created.

If you make a mistake or want to make changes later, you can edit the created Scheduled Transactions directly.</property>
            <property name="wrap">1</property>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkAssistantPage">
        <property name="title" translatable="1">Loan Details</property>
<property name="child">
          <object class="GtkBox" id="loan_info_page">
<property name="orientation">vertical</property>
            <child>
              <object class="GtkLabel" id="label1">
                <property name="valign">center</property>
                <property name="halign">center</property>
                <property name="label" translatable="1">Enter the Loan Details, as a minimum enter a valid Loan Account and Amount.
</property>
                <property name="justify">center</property>
                <property name="wrap">1</property>
              </object>
            </child>
            <child>
              <object class="GtkGrid" id="param_table">
                <property name="valign">center</property>
                <property name="halign">center</property>
<property name="row-spacing">6</property>
                <property name="column-spacing">6</property>
                <child>
                  <object class="GtkLabel" id="label847897">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Interest Rate</property>
                    <property name="justify">center</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label847899">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Start Date</property>
                    <property name="justify">center</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">4</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label847900">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Length</property>
                    <property name="justify">center</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">5</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label847895">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Amount</property>
                    <property name="justify">right</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label847920">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Loan Account</property>
                    <property name="justify">center</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkSpinButton" id="rem_spin">
                    <property name="focusable">1</property>

                    <property name="climb-rate">1</property>
                    <layout>
                      <property name="column">3</property>
                      <property name="row">5</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="hbox167">
                    <layout>
                      <property name="column">1</property>
                      <property name="row">5</property>
                    </layout>
                    <child>
                      <object class="GtkSpinButton" id="len_spin">
                        <property name="halign">center</property>
                        <property name="focusable">1</property>
<property name="climb-rate">1</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkComboBox" id="len_opt">
                        <property name="halign">center</property>
                        <property name="model">len_liststore</property>
                        <child>
                          <object class="GtkCellRendererText" id="cellrenderertext1" />
                          <attributes>
                            <attribute name="text">0</attribute>
                          </attributes>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label847898">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Type</property>
                    <property name="justify">center</property>
                    <layout>
                      <property name="column">2</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label847901">
                    <property name="halign">end</property>
                    <property name="label" translatable="1">Months Remaining</property>
                    <property name="justify">center</property>
                    <property name="ellipsize">end</property>
                    <layout>
                      <property name="column">2</property>
                      <property name="row">5</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkComboBox" id="type_combobox">
                    <property name="model">type_liststore</property>
                    <child>
                      <object class="GtkCellRendererText" id="cellrenderertext3" />
                      <attributes>
                        <attribute name="text">0</attribute>
                      </attributes>
                    </child>
                    <layout>
                      <property name="column">3</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="hbox170">
                    <layout>
                      <property name="column">1</property>
                      <property name="row">2</property>
                    </layout>
                    <child>
                      <object class="GtkComboBox" id="irate_type_combobox">
                        <property name="hexpand">1</property>
                        <property name="model">rate_liststore</property>
                        <child>
                          <object class="GtkCellRendererText" id="cellrenderertext2" />
                          <attributes>
                            <attribute name="text">0</attribute>
                          </attributes>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSpinButton" id="irate_spin">
                        <property name="hexpand">1</property>
                        <property name="focusable">1</property>
                        <property name="tooltip-text" translatable="1">Enter the annual interest rate in percent. Accepts values from 0.001 - 100. The Mortgage Assistant does not support zero-interest loans.</property>
<property name="climb-rate">1</property>
                        <property name="digits">3</property>
                        <property name="snap-to-ticks">1</property>
                        <property name="numeric">1</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label847921">
                        <property name="halign">center</property>
                        <property name="label" translatable="1">%</property>
                        <property name="justify">center</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkFrame" id="type_freq_frame">
                    <property name="label-xalign">0.5</property>
                    <property name="child">
                      <object class="GtkBox" id="type_freq_hbox">
</object>
                    </property>
                    <child type="label">
                      <object class="GtkLabel" id="label847976">
                        <property name="label" translatable="1">Interest Rate Change Frequency</property>
                      </object>
                    </child>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">3</property>
                      <property name="column-span">4</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <placeholder />
                </child>
                <child>
                  <placeholder />
                </child>
                <child>
                  <placeholder />
                </child>
                <child>
                  <placeholder />
                </child>
                <child>
                  <placeholder />
                </child>
                <child>
                  <placeholder />
                </child>
                <child>
                  <placeholder />
                </child>
                <child>
                  <placeholder />
                </child>
                <child>
                  <placeholder />
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkAssistantPage">
        <property name="title" translatable="1">Loan Repayment Options</property>
<property name="child">
          <object class="GtkBox" id="loan_options_page">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkLabel" id="label847903">
                <property name="valign">center</property>
                <property name="halign">center</property>
                <property name="margin-bottom">12</property>
                <property name="label" translatable="1">Do you utilize an escrow account, if so an account must be specified…</property>
                <property name="justify">center</property>
                <property name="wrap">1</property>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="vbox174">
                <property name="margin-start">12</property>
                <property name="margin-bottom">12</property>
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkCheckButton" id="opt_escrow_cb">
                    <property name="valign">center</property>
                    <property name="label" translatable="1">… utilize an escrow account for payments?</property>
