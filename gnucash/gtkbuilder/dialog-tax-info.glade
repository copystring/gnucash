                          </object>
                        </child>
                        <child>
                          <object class="GtkSpinButton" id="copy_spin_button">
                            <property name="focusable">1</property>
                            <property name="adjustment">copy_spin_adj</property>
                            <property name="climb-rate">1</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
    <action-widgets>
      <action-widget response="-6">cancel_button</action-widget>
      <action-widget response="-10">apply_button</action-widget>
      <action-widget response="-5">ok_button</action-widget>
    </action-widgets>
    <child internal-child="action_area">
      <object class="GtkBox" id="dialog-action_area14">
        <property name="visible">True</property>
        <child>
          <object class="GtkButton" id="cancel_button">
            <property name="label" translatable="1">_Cancel</property>
            <property name="focusable">1</property>
<property name="use-underline">1</property>
          </object>

        </child>
        <child>
          <object class="GtkButton" id="apply_button">
            <property name="label" translatable="1">_Apply</property>
            <property name="sensitive">0</property>
            <property name="focusable">1</property>
            <property name="receives-default">1</property>
            <property name="use-underline">1</property>
          <property name="hexpand">1</property></object>

        </child>
        <child>
          <object class="GtkButton" id="ok_button">
            <property name="label" translatable="1">_OK</property>
            <property name="focusable">1</property>
<property name="use-underline">1</property>
          </object>

        </child>
      </object>
    </child>
  </object>
</interface>
