<?xml version="1.0" encoding="utf-8"?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkDialog" id="reset_warnings_dialog">
<property name="title" translatable="1">Reset Warnings</property>
    <property name="default-width">400</property>
<signal name="response" handler="gnc_reset_warnings_response_cb" swapped="no" />
    <child internal-child="content_area">
      <object class="GtkBox" id="dialog-vbox1">
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <child>
          <object class="GtkCenterBox" id="vbox1">
            <property name="vexpand">1</property>
            <property name="orientation">vertical</property>

            <property name="start-widget">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkLabel" id="label65">
                    <property name="valign">center</property>
                    <property name="label" translatable="1">You have requested that the following warning dialogs not be presented. To re-enable any of these dialogs, select the check box next to the dialog, then click OK.</property>
                    <property name="wrap">1</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="no_warnings">
                    <property name="vexpand">1</property>
                    <property name="label" translatable="1">No warnings to reset.</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="perm_vbox_and_label">
                    <property name="vexpand">1</property>
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkLabel" id="label64">
                        <property name="valign">center</property>
                        <property name="halign">start</property>
                        <property name="label" translatable="1">Permanent Warnings</property>
                        <property name="use-markup">1</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="perm_vbox">
                        <property name="valign">center</property>
                        <property name="orientation">vertical</property>
                        <child>
                          <placeholder />
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="temp_vbox_and_label">
                    <property name="vexpand">1</property>
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkLabel" id="label63">
                        <property name="valign">center</property>
                        <property name="halign">start</property>
                        <property name="label" translatable="1">Temporary Warnings</property>
                        <property name="use-markup">1</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="temp_vbox">
                        <property name="valign">center</property>
                        <property name="orientation">vertical</property>
                        <child>
                          <placeholder />
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
            <property name="end-widget">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkBox" id="hbuttonbox">
                    <property name="visible">True</property>
<property name="halign">center</property>
                    <property name="spacing">12</property>
<child>
                      <object class="GtkButton" id="button3">
                        <property name="label" translatable="1">_Select All</property>
                        <property name="focusable">1</property>
<property name="receives-default">1</property>
                        <property name="use-underline">1</property>
                        <signal name="clicked" handler="gnc_reset_warnings_select_all_cb" swapped="no" />
                      </object>

                    </child>
                    <child>
                      <object class="GtkButton" id="button4">
                        <property name="label" translatable="1">_Unselect All</property>
                        <property name="focusable">1</property>
<property name="receives-default">1</property>
                        <property name="use-underline">1</property>
                        <signal name="clicked" handler="gnc_reset_warnings_unselect_all_cb" swapped="no" />
                      </object>

                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
    <action-widgets>
      <action-widget response="-6">cancelbutton</action-widget>
      <action-widget response="-10">applybutton</action-widget>
      <action-widget response="-5">okbutton</action-widget>
    </action-widgets>
    <child internal-child="action_area">
      <object class="GtkBox" id="dialog-action_area1">
        <property name="visible">True</property>
        <child>
          <object class="GtkButton" id="cancelbutton">
            <property name="label" translatable="1">_Cancel</property>
            <property name="focusable">1</property>
<property name="receives-default">1</property>
            <property name="use-underline">1</property>
          </object>

        </child>
        <child>
          <object class="GtkButton" id="applybutton">
            <property name="label" translatable="1">_Apply</property>
            <property name="focusable">1</property>
<property name="receives-default">1</property>
            <property name="use-underline">1</property>
          </object>

        </child>
        <child>
          <object class="GtkButton" id="okbutton">
            <property name="label" translatable="1">_OK</property>
            <property name="focusable">1</property>
<property name="receives-default">1</property>
            <property name="use-underline">1</property>
          </object>

        </child>
      </object>
    </child>
  </object>
</interface>
