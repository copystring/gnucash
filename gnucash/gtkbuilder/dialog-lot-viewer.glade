<?xml version="1.0" encoding="utf-8"?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkDialog" id="lot_viewer_dialog">
    <property name="title" translatable="1">Lot Viewer</property>
    <property name="default-width">600</property>
    <property name="default-height">400</property>
<signal name="destroy" handler="lv_window_destroy_cb" swapped="no" />
    <signal name="response" handler="lv_response_cb" swapped="no" />
    <child internal-child="content_area">
      <object class="GtkBox" id="dialog-vbox1">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkPaned" id="lot_vpaned">
            <property name="shrink-end-child">0</property>
            <property name="shrink-start-child">0</property>
            <property name="focusable">1</property>
            <property name="orientation">vertical</property>
            <property name="position">200</property>
            <property name="start-child">
              <object class="GtkPaned" id="lot_hpaned">
                <property name="resize-start-child">0</property>
                <property name="width-request">300</property>
                <property name="height-request">100</property>
                <property name="focusable">1</property>
<property name="position">200</property>
                <property name="start-child">
                  <object class="GtkGrid" id="table1">
                    <property name="margin-end">6</property>
                    <property name="row-spacing">3</property>
                    <property name="column-spacing">6</property>
                    <child>
                      <object class="GtkEntry" id="lot_title_entry">
                        <property name="focusable">1</property>
                        <property name="tooltip-text" translatable="1">Enter a name for the highlighted lot.</property>
                        <property name="halign">start</property>
                        <property name="hexpand">1</property>
                        <signal name="changed" handler="lv_title_entry_changed_cb" swapped="no" />
                        <layout>
                          <property name="column">0</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label19">
                        <property name="halign">start</property>
                        <property name="label" translatable="1">_Notes</property>
                        <property name="use-underline">1</property>
                        <property name="mnemonic-widget">lot_notes_text</property>
                        <style>
                          <class name="gnc-class-strong" />
                        </style>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow" id="scrolledwindow2">
                        <property name="hexpand">1</property>
                        <property name="vexpand">1</property>
<property name="child">
                          <object class="GtkTextView" id="lot_notes_text">
                            <property name="focusable">1</property>
                            <property name="tooltip-text" translatable="1">Enter any notes you want to make about this lot.</property>
                            <property name="margin-start">3</property>
                            <property name="margin-end">3</property>
                            <property name="hexpand">1</property>
                            <property name="wrap-mode">word</property>
                            <property name="accepts-tab">0</property>
                          </object>
                        </property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">3</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label8">
                        <property name="halign">start</property>
                        <property name="label" translatable="1">_Title</property>
                        <style>
                          <class name="gnc-class-strong" />
                        </style>
                        <property name="use-markup">1</property>
                        <property name="use-underline">1</property>
                        <property name="justify">center</property>
                        <property name="mnemonic-widget">lot_title_entry</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </property>
                <property name="end-child">
                  <object class="GtkGrid" id="table2">
                    <property name="margin-start">6</property>
                    <property name="row-spacing">3</property>
                    <property name="column-spacing">6</property>
                    <child>
                      <object class="GtkLabel" id="label9">
                        <property name="halign">start</property>
                        <property name="label" translatable="1">_Lots in This Account</property>
                        <style>
                          <class name="gnc-class-strong" />
                        </style>
                        <property name="use-markup">1</property>
                        <property name="use-underline">1</property>
                        <property name="mnemonic-widget">lot_view</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow" id="scrolledwindow5">
                        <property name="focusable">1</property>
                        <property name="hexpand">1</property>
                        <property name="vexpand">1</property>
                        <property name="hscrollbar-policy">always</property>
                        <property name="vscrollbar-policy">always</property>
<property name="child">
                          <object class="GtkTreeView" id="lot_view">
                            <property name="focusable">1</property>
                            <property name="enable-search">0</property>
                            <child internal-child="selection">
                              <object class="GtkTreeSelection" id="treeview-selection1" />
                            </child>
                          </object>
                        </property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="only_show_open_lots_checkbutton">
                        <property name="label" translatable="1">Show only open lots</property>
                        <property name="focusable">1</property>
                        <property name="halign">start</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
            <property name="end-child">
              <object class="GtkPaned" id="split_hpaned">
                <property name="focusable">1</property>
                <property name="start-child">
                  <object class="GtkGrid" id="table3">
                    <property name="margin-end">6</property>
                    <property name="margin-top">3</property>
                    <property name="margin-bottom">3</property>
                    <property name="hexpand">1</property>
                    <property name="row-spacing">3</property>
                    <property name="column-spacing">6</property>
                    <child>
                      <object class="GtkLabel" id="label10">
                        <property name="halign">start</property>
                        <property name="label" translatable="1">Splits _free</property>
                        <style>
                          <class name="gnc-class-strong" />
                        </style>
                        <property name="use-markup">1</property>
                        <property name="use-underline">1</property>
                        <property name="mnemonic-widget">split_free_view</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow" id="scrolledwindow4">
                        <property name="focusable">1</property>
                        <property name="hexpand">1</property>
                        <property name="vexpand">1</property>
<property name="child">
                          <object class="GtkTreeView" id="split_free_view">
                            <property name="focusable">1</property>
                            <property name="enable-search">0</property>
                            <child internal-child="selection">
                              <object class="GtkTreeSelection" id="treeview-selection2" />
                            </child>
                          </object>
                        </property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </property>
                <property name="end-child">
                  <object class="GtkGrid" id="table4">
                    <property name="margin-start">6</property>
                    <property name="margin-top">3</property>
                    <property name="margin-bottom">3</property>
                    <property name="hexpand">1</property>
                    <property name="row-spacing">3</property>
                    <property name="column-spacing">6</property>
                    <child>
                      <object class="GtkLabel" id="label1">
                        <property name="halign">start</property>
                        <property name="label" translatable="1">Splits _in lot</property>
                        <style>
                          <class name="gnc-class-strong" />
                        </style>
                        <property name="use-markup">1</property>
                        <property name="use-underline">1</property>
                        <property name="mnemonic-widget">split_in_lot_view</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow" id="scrolledwindow1">
                        <property name="focusable">1</property>
                        <property name="hexpand">1</property>
                        <property name="vexpand">1</property>
<property name="child">
                          <object class="GtkTreeView" id="split_in_lot_view">
                            <property name="focusable">1</property>
                            <property name="enable-search">0</property>
                            <child internal-child="selection">
                              <object class="GtkTreeSelection" id="treeview-selection3" />
                            </child>
                          </object>
                        </property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">1</property>
                          <property name="row-span">4</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="add_split_to_lot_button">
                        <property name="label" comments="Auto-reversed for RTL writing">&gt;&gt;</property>
                        <property name="focusable">1</property>
                        <property name="receives-default">1</property>
                        <property name="halign">center</property>
                        <property name="valign">center</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="remove_split_from_lot_button">
                        <property name="label" comments="Auto-reversed for RTL writing">&lt;&lt;</property>
                        <property name="focusable">1</property>
                        <property name="receives-default">1</property>
                        <property name="halign">center</property>
                        <property name="valign">center</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">3</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <placeholder />
                    </child>
                    <child>
                      <placeholder />
                    </child>
                    <child>
                      <placeholder />
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
    <action-widgets>
      <action-widget response="5">new_lot_button</action-widget>
      <action-widget response="4">scrub_account_button</action-widget>
      <action-widget response="3">scrub_lot_button</action-widget>
      <action-widget response="2">delete_button</action-widget>
      <action-widget response="-7">button5</action-widget>
    </action-widgets>
    <child internal-child="action_area">
      <object class="GtkBox" id="dialog-action_area1">
        <property name="visible">True</property>
        <child>
          <object class="GtkButton" id="new_lot_button">
            <property name="label" translatable="1">_New Lot</property>
            <property name="focusable">1</property>
<property name="use-underline">1</property>
          </object>

        </child>
        <child>
          <object class="GtkButton" id="scrub_account_button">
            <property name="label" translatable="1">Scrub _Account</property>
            <property name="focusable">1</property>
<property name="use-underline">1</property>
          </object>

        </child>
        <child>
          <object class="GtkButton" id="scrub_lot_button">
            <property name="label" translatable="1">_Scrub</property>
            <property name="sensitive">0</property>
            <property name="focusable">1</property>
<property name="tooltip-text" translatable="1">Scrub the highlighted lot</property>
            <property name="use-underline">1</property>
          </object>

        </child>
        <child>
          <object class="GtkButton" id="delete_button">
            <property name="label" translatable="1">_Delete</property>
            <property name="sensitive">0</property>
            <property name="focusable">1</property>
<property name="tooltip-text" translatable="1">Delete the highlighted lot</property>
            <property name="use-underline">1</property>
          </object>

        </child>
        <child>
          <object class="GtkButton" id="button5">
            <property name="label" translatable="1">_Close</property>
            <property name="focusable">1</property>
<property name="use-underline">1</property>
          </object>

        </child>
      </object>
    </child>
  </object>
</interface>
