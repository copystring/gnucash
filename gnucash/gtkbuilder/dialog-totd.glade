<?xml version="1.0" encoding="utf-8"?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkDialog" id="totd_dialog">
<property name="title" translatable="1">GnuCash Tip Of The Day</property>
    <property name="default-width">400</property>
    <property name="default-height">300</property>
<signal name="response" handler="gnc_totd_dialog_response_cb" swapped="no" />
    <child internal-child="content_area">
      <object class="GtkBox" id="dialog-vbox3">
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <child>
          <object class="GtkBox" id="totd_vbox">
            <property name="vexpand">1</property>
<property name="orientation">vertical</property>
            <property name="spacing">18</property>
            <child>
              <object class="GtkBox" id="vbox2">
                <property name="vexpand">1</property>
                <property name="orientation">vertical</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkLabel" id="label3">
                    <property name="valign">center</property>
                    <property name="halign">start</property>
                    <property name="label" translatable="1">Tip of the Day</property>
                    <style>
                      <class name="gnc-class-strong" />
                    </style>
                    <property name="use-markup">1</property>
                    <property name="use-underline">1</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="hbox3">
                    <property name="vexpand">1</property>
                    <child>
                      <object class="GtkTextView" id="tip_textview">
                        <property name="hexpand">1</property>
                        <property name="focusable">1</property>
                        <property name="margin-start">3</property>
                        <property name="margin-end">3</property>
<property name="editable">0</property>
                        <property name="wrap-mode">word</property>
                        <property name="left-margin">5</property>
                        <property name="right-margin">5</property>
                        <property name="cursor-visible">0</property>
                        <property name="accepts-tab">0</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkCheckButton" id="show_checkbutton">
                <property name="valign">center</property>
                <property name="label" translatable="1">_Show tips at startup</property>
                <property name="focusable">1</property>
                <property name="halign">start</property>
                <property name="use-underline">1</property>
                <signal name="toggled" handler="gnc_totd_dialog_startup_toggled_cb" swapped="no" />
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <action-widgets>
      <action-widget response="2">back-button</action-widget>
      <action-widget response="1">forward-button</action-widget>
      <action-widget response="-7">close-button</action-widget>
    </action-widgets>
    <child internal-child="action_area">
      <object class="GtkBox" id="dialog-action_area3">
        <property name="visible">True</property>
        <child>
          <object class="GtkButton" id="back-button">
            <property name="label" translatable="1">_Previous</property>
            <property name="focusable">1</property>
<property name="receives-default">1</property>
            <property name="use-underline">1</property>
          </object>

        </child>
        <child>
          <object class="GtkButton" id="forward-button">
            <property name="label" translatable="1">_Next</property>
            <property name="focusable">1</property>
<property name="receives-default">1</property>
            <property name="use-underline">1</property>
          </object>

        </child>
        <child>
          <object class="GtkButton" id="close-button">
            <property name="label" translatable="1">_Close</property>
            <property name="focusable">1</property>
<property name="receives-default">1</property>
            <property name="use-underline">1</property>
          </object>

        </child>
      </object>
    </child>
  </object>
</interface>
